# Copy this file to .env and fill in what you have. Everything is optional.

# Run the built-in sensor simulator (true for demos, false when real nodes post data)
SIMULATE=true
SIM_INTERVAL_S=2

# Fetch live rainfall forecast (Open-Meteo) and earthquakes (USGS). No keys needed.
USE_LIVE_DATA=true

# NASA FIRMS active-fire hotspots (free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Telegram alerts: create a bot with @BotFather, then message it and read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# If set, POST /api/readings and hiker endpoints require the header X-API-Key: <value>
INGEST_API_KEY=

# Demo timings
ALERT_COOLDOWN_S=20
HIKER_OVERDUE_S=40

# Phone alerts via Twilio (SMS or WhatsApp). Leave empty to run in demo mode
# (messages appear in the dashboard message log but are not really sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEFAULT_COUNTRY_CODE=+91
